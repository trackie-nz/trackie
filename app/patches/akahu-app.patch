+/*
+Trackie: NZ bank transfers carry the payer-typed text in the particulars, code
+and reference fields, not in the description. Upstream writes only the
+description to notes, so that text never reaches the budget. Blanks and
+duplicates are dropped (banks often repeat the description in one of the fields).
+*/
+const NOTE_META_FIELDS = ['particulars', 'code', 'reference'] as const;
+
+function getNotes(trans: AnyTransaction): string {
+  const meta = 'meta' in trans && trans.meta ? trans.meta : undefined;
+  const parts = [trans.description, ...NOTE_META_FIELDS.map(f => meta?.[f])];
+  const seen = new Set<string>();
+  const unique: string[] = [];
+  for (const part of parts) {
+    const value = part?.trim();
+    if (!value || seen.has(value.toLowerCase())) continue;
+    seen.add(value.toLowerCase());
+    unique.push(value);
+  }
+  return unique.join(' ');
+}
